# T3: add config SND_RK29_WM8731 (MTC RK3188 + Wolfson WM8731 machine).
# Base: SDK rk3188_rk3066_r-box_android4.4.2 kernel/sound/soc/rk29/Kconfig
# Apply with: patch -p1 < sound/soc/rk29/Kconfig.patch  (from kernel root)
# T5 note: контекст обновлён под фактический SDK-файл (после WM8900-блока идут RT5512/CX2070X,
#          а не RT5621 — старый патч падал "Hunk #1 FAILED at 120").
--- a/sound/soc/rk29/Kconfig
+++ b/sound/soc/rk29/Kconfig
@@ -139,6 +139,17 @@
 	help
 	  Say Y if you want to add support for SoC audio on rockchip
 	  with the WM8900.
+#$_rbox_$_modify_$_begin
+# T3 binaRE: MTC RK3188 + Wolfson WM8731 machine (bin-sig rk29_wm8731_init @0xc0862494)
+config SND_RK29_WM8731
+	bool "Rockchip RK3188 + Wolfson WM8731 machine"
+	depends on SND_SOC
+	select SND_RK29_SOC_I2S
+	select SND_SOC_WM8731
+	help
+	  MTC board: rockchip-audio platform, rk29_i2s.1, WM8731 codec (i2c 0x1c).
+	  Machine driver recovered from MTC binary (T3).
+#$_rbox_$_modify_$_end
 
 config SND_RK29_SOC_RT5512
 	tristate "SoC I2S Audio support for rockchip - RICHTEK5512"
 
