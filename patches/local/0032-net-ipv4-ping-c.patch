 /*
+ * Common validation for ping/pingv6 sendmsg: message size, flags and
+ * the ICMP header supplied by userland.
+ */
+int ping_common_sendmsg(int family, struct msghdr *msg, size_t length,
+			void *buf, size_t buf_size)
+{
+	if (length > 0xFFFF)
+		return -EMSGSIZE;
+
+	if (msg->msg_flags & MSG_OOB)
+		return -EOPNOTSUPP;
+
+	if (memcpy_fromiovec(buf, msg->msg_iov, sizeof(struct icmphdr)))
+		return -EFAULT;
+
+	if (family == AF_INET6) {
+		struct icmp6hdr *icmph = buf;
+		if (icmph->icmp6_type != ICMPV6_ECHO_REQUEST &&
+		    icmph->icmp6_type != ICMPV6_ECHO_REPLY &&
+		    icmph->icmp6_type != ICMPV6_DEST_UNREACH)
+			return -EINVAL;
+	} else {
+		struct icmphdr *icmph = buf;
+		if (!ping_supported(icmph->type, icmph->code))
+			return -EINVAL;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(ping_common_sendmsg);
