 	struct net *net = sock_net(sk);
+#ifdef CONFIG_IPV6
+	struct net_device *dev = NULL;
+#endif
 
 	if (sk->sk_family == AF_INET) {
 		struct sockaddr_in *addr = (struct sockaddr_in *)uaddr;
@@ -1003,8 +1006,39 @@
 
 #ifdef CONFIG_IPV6
 	} else if (sk->sk_family == AF_INET6) {
-		/* упрощение 3.0: IPv6-ветка — no-op (соответствующие поля/макросы
-		 * нет в урезанных ipv6-заголовках tree 3.0); IPv4-ветка верна. */
+		struct sockaddr_in6 *addr = (struct sockaddr_in6 *)uaddr;
+		int type, chk_addr_ret;
+
+		if (addr_len < sizeof(*addr))
+			return -EINVAL;
+
+		type = ipv6_addr_type(&addr->sin6_addr);
+		if (!(type & IPV6_ADDR_LINKLOCAL)) {
+			rcu_read_lock();
+
+			if (addr->sin6_scope_id) {
+				dev = dev_get_by_index_rcu(net, addr->sin6_scope_id);
+				if (!dev) {
+					rcu_read_unlock();
+					return -ENODEV;
+				}
+			} else {
+				dev = NULL;
+			}
+
+			chk_addr_ret = pingv6_ops.ipv6_chk_addr(net,
+						 &addr->sin6_addr, dev, 0);
+			rcu_read_unlock();
+
+			if (chk_addr_ret == 0 &&
+			    isk->freebind == 0 && isk->transparent == 0 &&
+			    type != IPV6_ADDR_ANY)
+				return -EADDRNOTAVAIL;
+		}
+		if (type & IPV6_ADDR_LINKLOCAL) {
+			sk->sk_bound_dev_if = addr->sin6_scope_id;
+		}
+
 		return 0;
 #endif
 	} else {
@@ -1014,7 +1048,9 @@
 }
 
